generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum OrderStatus {
  PENDING
  SUBMITTED
  PAID
  SENT_TO_THIRD_PARTY
  RECEIVED_FROM_THIRD_PARTY
  PREPARING_DELIVERY
  DELIVERED
  REJECTED
}

model Product {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  price       Float
  imageUrl    String

  // NEW: Category relation
  categoryId String?   @db.ObjectId
  category   Category? @relation(fields: [categoryId], references: [id])

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model Category {
  id       String    @id @default(auto()) @map("_id") @db.ObjectId
  name     String    @unique
  products Product[]

  // Embedded Promo Logic
  hasPromo     Boolean @default(false)
  minQuantity  Int? // e.g., 2
  discountRate Float? // e.g., 0.10 for 10%
}

